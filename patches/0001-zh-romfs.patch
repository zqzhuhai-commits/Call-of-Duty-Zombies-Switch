-        if (*str == ' ')
-            width += 4 * scale_int;
-        else if ((byte) * str < 33 || (byte) * str > 126)
-            width += 8 * scale_int;
-        else
-            width += (font_kerningamount[(byte) * str - 33] + 1) * scale_int;
-        ++str;
+    const char *cursor = ZH_Translate(str);
+    while (*cursor) {
+        unsigned int cp = ZH_Decode(&cursor);
+        if (cp > 255) width += ZH_GLYPH_CELL*scale_int;
+        else if (cp == ' ') width += 4*scale_int;
+        else if (cp < 33 || cp > 126) width += 8*scale_int;
+        else width += (font_kerningamount[cp-33]+1)*scale_int;
     }
     return width;
 }
