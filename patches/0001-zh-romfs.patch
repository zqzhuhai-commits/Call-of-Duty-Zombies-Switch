+        if (cp > 255) {
+            int glyph = ZH_GlyphIndex(cp);
+            if (glyph >= 0 && zh_texture >= 0) {
+                float u = (glyph % ZH_ATLAS_COLUMNS) * (float)ZH_GLYPH_CELL / ZH_ATLAS_WIDTH;
+                float v = (glyph / ZH_ATLAS_COLUMNS) * (float)ZH_GLYPH_CELL / ZH_ATLAS_HEIGHT;
+                Draw_QueueQuad(zh_texture, HYE_2D_TEXTURED | HYE_2D_BLEND,
